{
  "schema_version": "1.0",
  "scenarios": [
    {
      "id": "initialize_requires_confirmation",
      "description": "显式调用 Skill 请求初始化，但没有确认当前提案修订号",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["no_formal_write_before_confirmation"]
    },
    {
      "id": "initialize_after_confirmation",
      "description": "续接同一会话并确认当前提案修订号后初始化",
      "invocation": "explicit",
      "turns": 2,
      "invariants": ["valid_initialized_target"]
    },
    {
      "id": "existing_target_is_preserved",
      "description": "正式知识库目录已存在时保留全部文件和哨兵内容",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["existing_target_preserved"]
    },
    {
      "id": "natural_language_triggers_skill",
      "description": "不写 Skill 名称，仅用自然语言请求检查项目知识库",
      "invocation": "natural_language",
      "turns": 1,
      "invariants": ["skill_trigger_observed"]
    },
    {
      "id": "review_is_read_only",
      "description": "规格审查不得修改正式知识",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["no_formal_write_before_confirmation"]
    },
    {
      "id": "review_reports_blockers",
      "description": "阻塞问题审查不得猜测或写回答案",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["no_formal_write_before_confirmation"]
    },
    {
      "id": "openspec_mapping_is_read_only",
      "description": "OpenSpec 映射保持只读",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["no_formal_write_before_confirmation"]
    },
    {
      "id": "spec_kit_mapping_is_read_only",
      "description": "Spec Kit 映射保持只读",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["no_formal_write_before_confirmation"]
    },
    {
      "id": "external_status_is_not_approval",
      "description": "外部完成或归档状态不得批准正式知识",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_single_source_read_only",
      "description": "单来源摄取输出新增候选和路由但不写正式知识",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_report_fields", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_multiple_sources_blocked",
      "description": "多个独立来源按第一版契约阻塞并要求拆分",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_blocked", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_conflict_read_only",
      "description": "竞争来源输出冲突候选并保留双方定位",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_conflict", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_natural_language_not_triggered",
      "description": "未显式调用时不得执行 ingest 或输出 ingest 报告",
      "invocation": "natural_language",
      "turns": 1,
      "invariants": ["ingest_not_triggered", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_sensitive_source_blocked",
      "description": "含虚构敏感值的来源必须阻塞且不得回显值",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_blocked", "sensitive_value_not_echoed", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_ai_inference_source_blocked",
      "description": "ai_inference 不得作为摄取主来源",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_blocked", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_missing_kb_routes_init",
      "description": "知识库缺失时只路由初始化",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_routes_init", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_unsupported_format_routes_upgrade",
      "description": "格式不兼容时只路由升级",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_routes_upgrade", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_revise_route",
      "description": "同一稳定身份的更新路由为 revise",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_revise", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_retire_route",
      "description": "停止使用的当前事实路由为 retire",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_retire", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_ignore_route",
      "description": "与当前事实完全重复的来源路由为 ignore",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_ignore", "no_formal_write_before_confirmation"]
    },
    {
      "id": "ingest_composite_add_revise_route",
      "description": "同一来源的新增与修订进入一个复合 route_plan",
      "invocation": "explicit",
      "turns": 1,
      "invariants": ["ingest_composite_route", "no_formal_write_before_confirmation"]
    }
  ]
}
